{
  "name": "stellariq-contract",
  "version": "0.1.0",
  "private": true,
  "description": "StellarIQ Data & Intelligence layer (stellariq-data): indexer, price engine, analytics engine, routing engine",
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "lint": "eslint ./scripts ./database --ext .mjs,.js,.cjs 2>/dev/null || eslint scripts database",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -b tsconfig.json || tsc --noEmit -p tsconfig.json",
    "test": "node --test tests/unit/*.test.mjs tests/integration/*.test.mjs 2>/dev/null || node --test tests/"
  },
  "engines": { "node": ">=20" }
}
