{
  "name": "stellariq-data",
  "version": "0.1.0",
  "private": true,
  "description": "StellarIQ Data & Intelligence layer (stellariq-data): indexer, price engine, analytics engine, routing engine",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "test": "npm run build && node --test $(find tests -name '*.test.mjs')"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "debug": "^4.4.3",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^6.0.0",
    "postgres": "^3.4.9"
  }
}
